graph TD
    subgraph Main Agent Task
        A[Start: Goal Definition] --> B{Prepare Inputs & Schema};
        B --> C{Invoke `map` tool};
    end

    subgraph Parallel Sub-Agents
        C -- Fan-Out --> D1[Sub-Agent 1<br/>Prompt: '...for Stripe...'];
        C -- Fan-Out --> D2[Sub-Agent 2<br/>Prompt: '...for Instacart...'];
        C -- Fan-Out --> D3[Sub-Agent 3<br/>Prompt: '...for Coinbase...'];
        C -- Fan-Out --> D_N[Sub-Agent N<br/>Prompt: '...for Company N...'];

        D1 --> E1{Research & Extract Data};
        D2 --> E2{Research & Extract Data};
        D3 --> E3{Research & Extract Data};
        D_N --> E_N{Research & Extract Data};

        E1 --> F1[Return Structured JSON];
        E2 --> F2[Return Structured JSON];
        E3 --> F3[Return Structured JSON];
        E_N --> F_N[Return Structured JSON];
    end

    subgraph Main Agent Task
        F1 -- Fan-In --> G{Aggregate Results};
        F2 -- Fan-In --> G;
        F3 -- Fan-In --> G;
        F_N -- Fan-In --> G;
        G --> H[Process Aggregated Data<br/>e.g., create table, analyze];
        H --> I[End: Deliver Result];
    end

    style A fill:#c9f,stroke:#333,stroke-width:2px
    style I fill:#c9f,stroke:#333,stroke-width:2px
    style C fill:#f9f,stroke:#333,stroke-width:4px
    style G fill:#f9f,stroke:#333,stroke-width:4px
