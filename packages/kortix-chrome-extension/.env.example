# Kortix Browser Operator - Environment Variables
# Documentation: See README.md for portability system details

# The full URL of your Kortix Frontend instance
# This is used for match pattern injection and postMessage security.
# Example: https://kortix.com or http://localhost:3000 or your custom domain
NEXT_PUBLIC_URL=http://localhost:3000

# The full API URL of your Kortix Backend
# This is used for WebSocket connectivity and API requests.
# Example: https://api.kortix.com/v1 or http://localhost:8000/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/v1

#For Railway Deployments use the Kortix Community Template at https://railway.com/deploy/5wut09?referralCode=3tMBLG&utm_medium=integration&utm_source=template&utm_campaign=generic

#Otherwise, manually set the environment variables in Kortix Browser Operator service
#NEXT_PUBLIC_URL=${{Kortix Frontend.NEXT_PUBLIC_URL}}
#NEXT_PUBLIC_BACKEND_URL=${{Kortix Frontend.NEXT_PUBLIC_BACKEND_URL}}