{
  "manifest_version": 3,
  "name": "Kortix Browser Operator",
  "version": "1.0.0",
  "description": "Connect your browser to your Kortix Workers to help you complete everyday tasks that require your personal context. Enable full browser internet access for Kortix Community Edition.",
  "permissions": [
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://suna.syhc.dev/*",
        "https://kortix.com/*",
        "https://*.kortix.com/*",
        "https://*.syhc.dev/*"
      ],
      "js": [
        "connect-bridge.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kortix Browser Operator",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}